---
import { site } from '../site';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  draft?: boolean;
}
const { title, description = site.intro, image, draft = false } = Astro.props;
const socialTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const links = [
  { label: 'Writing', href: '/writing/' },
  { label: 'Work', href: '/work/' },
  { label: 'Notebook', href: '/notebook/' },
  { label: 'whoami', href: '/about/' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#27143E" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>yousefnegm</title>
    <meta name="description" content={description} />
    {draft && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    {image && <meta property="og:image" content={new URL(image, canonical)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>{site.author}</a>
        <button class="menu-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="main-navigation" hidden>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
            <path class="menu-open-icon" d="M4 6h16M4 12h16M4 18h16" />
            <path class="menu-close-icon" d="m6 6 12 12M18 6 6 18" />
          </svg>
        </button>
        <nav id="main-navigation" aria-label="Main navigation">
          {links.map(({ label, href }) => (
            <a href={href} aria-current={Astro.url.pathname === href ? 'page' : Astro.url.pathname.startsWith(href) ? 'location' : undefined}>
              {label === 'whoami' ? <code class="terminal-command"><span aria-hidden="true">$ </span>{label}</code> : label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');

      if (toggle) {
        toggle.hidden = false;
        toggle.addEventListener('click', () => {
          toggle.setAttribute('aria-expanded', String(toggle.getAttribute('aria-expanded') !== 'true'));
        });

        toggle.closest('.site-header')?.addEventListener('keydown', (event) => {
          if (!(event instanceof KeyboardEvent) || event.key !== 'Escape' || toggle.getAttribute('aria-expanded') !== 'true') return;

          toggle.setAttribute('aria-expanded', 'false');
          toggle.focus();
        });
      }
    </script>
  </body>
</html>
