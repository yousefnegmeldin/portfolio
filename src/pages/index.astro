---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import GitHubActivity from '../components/GitHubActivity.astro';
import Base from '../layouts/Base.astro';
import { entryUrl, getEntries } from '../lib/entries';
import { site } from '../site';

const [writing, work, notebook] = await Promise.all([
  getEntries('writing'),
  getEntries('work'),
  getEntries('notebook'),
]);
const projects = work.filter(({ data }) => data.featured).slice(0, 2);
const essay = writing[0];
const note = notebook[0];
const socialIcons = {
  LinkedIn: 'M20.45 2H3.55C2.7 2 2 2.67 2 3.5v17c0 .83.7 1.5 1.55 1.5h16.9c.86 0 1.55-.67 1.55-1.5v-17c0-.83-.69-1.5-1.55-1.5ZM7.93 19.05H4.96V9.5h2.97v9.55ZM6.45 8.19a1.72 1.72 0 1 1 0-3.44 1.72 1.72 0 0 1 0 3.44Zm12.59 10.86h-2.96V14.4c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.72H9.78V9.5h2.84v1.31h.04a3.11 3.11 0 0 1 2.8-1.54c3 0 3.56 1.98 3.56 4.55v5.23Z',
  GitHub: 'M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54l-.01-2.09c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1.01 1.72 2.64 1.22 3.28.94.1-.73.39-1.22.71-1.5-2.5-.28-5.12-1.25-5.12-5.56 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.09 1.15a10.76 10.76 0 0 1 5.62 0c2.14-1.45 3.08-1.15 3.08-1.15.62 1.55.23 2.7.12 2.98.72.79 1.15 1.79 1.15 3.02 0 4.32-2.63 5.27-5.14 5.55.4.35.76 1.04.76 2.09v3.08c0 .3.2.65.78.54A11.25 11.25 0 0 0 12 .75Z',
  X: 'M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.64 7.584H.47l8.6-9.835L0 1.154h7.594l5.243 6.932 6.064-6.933Zm-1.29 19.49h2.039L6.488 3.24H4.3l13.31 17.403Z',
};
---
<Base>
  <section class="hero">
    <div class="shell hero-inner">
      <div class="hero-copy">
        <h1>In the <em>works.</em></h1>
        <p>{site.intro}</p>
        <nav class="hero-socials" aria-label="Social profiles">
          {site.socials.map(({ label, url }) => (
            <a href={url} rel="me" aria-label={label} title={label}>
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={socialIcons[label]} />
              </svg>
            </a>
          ))}
        </nav>
      </div>
      <div class="portrait">
        <Image src={portrait} alt="Portrait of Yousef Negmeldin" width={512} height={512} format="webp" loading="eager" />
        <span class="portrait-pin" aria-hidden="true"></span>
      </div>
    </div>
  </section>
  <div class="shell home-content">
    {projects.length > 0 && (
      <section class="selected-work" aria-labelledby="selected-work">
        <h2 id="selected-work">Selected work</h2>
        <div class:list={['work-tiles', { 'one-project': projects.length === 1 }]}>
          {projects.map((project) => (
            <div class="work-tile"><h3><a href={entryUrl(project)}>{project.data.title}</a></h3></div>
          ))}
        </div>
      </section>
    )}
    {(essay || note) && (
      <div class="home-indexes">
        {essay && <section><h2>Writing</h2><a href={entryUrl(essay)}>{essay.data.title}</a></section>}
        {note && <section><h2>Notebook</h2><a href={entryUrl(note)}>{note.data.title}</a></section>}
      </div>
    )}
    <GitHubActivity />
  </div>
</Base>

<script>
  const portraitFrame = document.querySelector('.portrait');
  const photo = portraitFrame?.querySelector('img');

  const canPlayLanding = matchMedia('(width > 720px) and (hover: hover) and (prefers-reduced-motion: no-preference)');

  if (portraitFrame && photo && canPlayLanding.matches) {
    const playWhenVisible = () => {
      if (!photo.naturalWidth) return;

      const threshold = 0.65;
      // Observe the frame so the moving image cannot affect the trigger.
      const observer = new IntersectionObserver(([entry]) => {
        if (entry.intersectionRatio < threshold) return;

        observer.disconnect();
        photo.classList.replace('portrait-pending', 'portrait-ready');
      }, { threshold });

      photo.classList.add('portrait-pending');
      observer.observe(portraitFrame);
    };

    if (photo.complete) playWhenVisible();
    else photo.addEventListener('load', playWhenVisible, { once: true });
  }
</script>
