---
import { Image } from 'astro:assets';
import awsBadge from '../assets/aws-developer-associate.png';
import Base from '../layouts/Base.astro';
import { site } from '../site';

const { credential, specialty, description } = site.studying;
---
<Base title="Currently studying" {description}>
  <div class="shell studying-page">
    <h1>Currently <em>studying</em></h1>
    <section class="study-focus" aria-labelledby="study-title">
      <div class="study-copy">
        <h2 id="study-title">{credential}<br />{specialty}</h2>
        <p>{description}</p>
      </div>
      <Image src={awsBadge} class="study-badge" alt="" />
    </section>
  </div>
</Base>

<style>
  .studying-page {
    padding-block: clamp(38px, 4.5vw, 64px) 76px;
  }

  .studying-page h1 {
    margin-bottom: clamp(28px, 4vw, 51px);
    font-size: clamp(44px, 7vw, 92px);
    line-height: 1.03;
    letter-spacing: -.055em;
  }

  .studying-page h1 em { color: var(--violet); }

  .study-focus {
    display: grid;
    align-items: center;
    gap: 28px;
    padding: clamp(24px, 3.33vw, 48px);
    background: #ebe2f3;
    border-top: 1px solid var(--rule);
  }

  .study-copy {
    display: grid;
    gap: clamp(14px, 1.45vw, 21px);
  }

  .study-status {
    color: var(--violet);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .study-copy h2 {
    font-size: clamp(34px, 4.4vw, 64px);
    line-height: 1.02;
  }

  .study-copy p:last-child {
    max-width: 430px;
    color: var(--muted);
    font-size: clamp(17px, 1.4vw, 19px);
  }

  .study-badge {
    justify-self: center;
    width: min(52%, 170px);
  }

  @media (width > 720px) {
    .study-focus {
      grid-template-columns: minmax(0, 1fr) clamp(160px, 22vw, 300px);
      min-height: 400px;
    }

    .study-badge { width: min(100%, 264px); }
  }
</style>
